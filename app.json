{
  "expo": {
    "name": "viro-meta",
    "slug": "viro-meta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "virometa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.virometa.xr",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for passthrough AR in the Babylon XR demo.",
        "NSMicrophoneUsageDescription": "Used for voice input in the Babylon XR demo."
      }
    },
    "android": {
      "package": "com.virometa.xr",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.oculus.permission.USE_ANCHOR_API",
        "com.oculus.permission.USE_SCENE",
        "horizonos.permission.HORIZON_CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "target": "universal"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-quest-build-fixes.js",
      [
        "@reactvision/react-viro",
        {
          "ios": {
            "cameraUsagePermission": "Used for AR in the Viro demo."
          },
          "android": {
            "xRMode": ["AR", "QUEST"]
          }
        }
      ],
      [
        "expo-horizon-core",
        {
          "horizonAppId": "1234567890",
          "defaultHeight": "800dp",
          "defaultWidth": "1280dp",
          "supportedDevices": "quest2|questpro|quest3|quest3s"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
