{
  "name": "viro-meta",
  "license": "0BSD",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 npx expo start --https",
    "start:https": "expo start --https",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "quest": "expo run:android --variant questRelease --device",
    "quest:debug": "expo run:android --variant questDebug --device",
    "quest:prebuild": "expo prebuild --platform android --clean",
    "quest:build": "cd android && ./gradlew :app:assembleQuestRelease",
    "quest:build:debug": "cd android && ./gradlew :app:assembleQuestDebug",
    "quest:install": "adb install -r android/app/build/outputs/apk/quest/release/app-quest-release.apk",
    "quest:install:debug": "adb install -r android/app/build/outputs/apk/quest/debug/app-quest-debug.apk",
    "quest:launch": "adb shell am start -n com.virometa.xr/.MainActivity",
    "quest:logs": "adb logcat -s ReactNative:V ReactNativeJS:V VRActivity:V Unity:V *:S",
    "quest:stop": "adb shell am force-stop com.virometa.xr",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "mcp": "EXPO_UNSTABLE_MCP_SERVER=1 npx expo-mcp --dev-server-url http://localhost:8081",
    "mcp:tunnel": "EXPO_UNSTABLE_MCP_SERVER=1 npx expo-mcp --dev-server-url http://localhost:8081 --mcp-server-url https://mcp.expo.dev",
    "postinstall": "node ./scripts/patch-viro-meta.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@reactvision/react-viro": "^2.54.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.9",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-horizon-core": "^55.0.1",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-mcp": "^0.2.4",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-permissions": "^5.5.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "0.81.5",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "metro": "^0.84.3",
    "metro-resolver": "^0.84.3",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
